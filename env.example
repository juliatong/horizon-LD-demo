# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────

# LaunchDarkly Client-side ID
# Find at: LD Dashboard -> Project Settings -> Environments
#          -> select your environment -> Client-side ID
# Must be the Client-side ID, NOT the server-side SDK key.
# The client-side ID is safe to expose in browser code.
VITE_LD_CLIENT_SIDE_ID=your-client-side-id-here
